[project]
-> name        => LegendaryOS
-> tag         => stable
-> version     => 2026.10
-> description => LegendaryOS -- klasyczny (HackerOS / Debian testing) albo atomowy (Fedora Silverblue)
-> targets     => [pc:amd64]

[release]
-> base     => hackeros
-> base-ref => official
-> suite    => forky

[fedora]
-> version     => 44
-> filesystem  => ext4
-> kernel-args => quiet splash mitigations=off

[container]
-> registry => ghcr.io/legendaryos-linux-system
-> image    => legendaryos-fedora
-> push     => false

[branding]
-> distro-name => LegendaryOS
-> accent      => #6236B0
-> background  => #120C1E
-> home-url    => https://github.com/LegendaryOS-Linux-System

[build]
-> iso-name     => LegendaryOS
-> volume-label => LegendaryOS-2026-10
-> publisher    => LegendaryOS-Linux-System
-> bootappend   => boot=live components quiet splash mitigations=off

[packages]
-> desktop         => blue-environment
-> display-manager => auto

[system]
-> hostname         => legendaryos
-> locale           => pl_PL.UTF-8
-> timezone         => Europe/Warsaw
-> keyboard         => pl
-> services-enable  => [sshd, NetworkManager, bluetooth, cups, fstrim.timer]
-> services-disable => [ModemManager]
-> generate-identity => true

[base]
-> import => [package-lists]

[live]
-> markers => auto
