[distro]
-> name    => LegendaryOS
-> id      => legendaryos
-> version => 0.2.0
-> arch    => x86_64
-> channel => rolling

[base]
! LegendaryOS bazuje na Fedorze (pakiety RPM). Bez dnf — ani przy budowie, ani w gotowym systemie.
-> distro  => fedora
-> release => 43

[packages]
! Przy budowie rootfs: lepm (../lepm) = rpm-md -> satsolv -> pobranie -> rozpakowanie. W systemie: lpm.
! Oba używają tych samych plików (repos.hk, compat.hk), które jadą też w obrazie (/system/share/legendaryos/).
-> manager => lepm
-> repos   => repos.hk
-> policy  => compat.hk

[init]
! zamiast systemd — zenitd (Zenit Linux). Skrypt instalacyjny pobierany przy budowie.
-> service_manager        => zenitd
-> zenitd_repo            => https://github.com/Zenit-Linux/zenitd
-> zenitd_install_script  => https://raw.githubusercontent.com/Zenit-Linux/zenitd/main/scripts/install.sh

[layout]
! niezmienne korzenie obrazu (patrz docs/PLAN.md)
-> immutable => [/system, /packages, /tools]
-> mutable   => [/state, /home]

[editions]
! Edycje (editions/<id>/edition.hk). `legendaryos-builder build . --edition all` buduje wszystkie po kolei.
-> list    => [plasma, xfce, gnome, cosmic, blue, server]
-> default => plasma

[boot]
! domyślne; edycja może nadpisać w edition.hk (kernel_args)
-> kernel_args => quiet rhgb

[targets]
-> formats => [iso, oci]

[image]
! Nazwa OCI i ISO powstaje jako <oci_name>-<edycja>, np. legendaryos-plasma
-> oci_name => legendaryos

[tools]
! /tools = jeden obraz squashfs (tools.sqfs) ze wszystkimi narzędziami z katalogu (wersje: manifest.hk / Bit.hk)
-> catalog => tools.hk
-> image   => tools.sqfs

[zsharp]
! Instalacja Z# (kompilator języka Zenit Linux) skryptem hlpp — hlpp jest pobierany jako narzędzie z katalogu.
-> script  => https://raw.githubusercontent.com/Zenit-Linux/Z-Sharp/main/scripts/LegendaryOS/install.hlpp
-> required => false
