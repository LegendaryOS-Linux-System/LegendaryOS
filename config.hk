[distro]
-> name    => LegendaryOS
-> id      => legendaryos
-> version => 0.1.0
-> arch    => x86_64
-> channel => rolling

[base]
! LegendaryOS bazuje na Fedorze (pakiety RPM). Bez dnf — ani przy budowie, ani w gotowym systemie.
-> distro  => fedora
-> release => 43

[packages]
! Przy budowie rootfs: lepm (../lepm) = rpm-md -> satsolv -> pobranie -> rozpakowanie. W systemie: lpm.
! Oba używają tych samych plików (repos.hk, compat.hk), które jadą też w obrazie (/system/share/legendaryos/).
-> manager => lepm
-> repos   => repos.hk
-> policy  => compat.hk

[init]
! zamiast systemd — zenitd (Zenit Linux). Skrypt instalacyjny pobierany przy budowie.
-> service_manager        => zenitd
-> zenitd_repo            => https://github.com/Zenit-Linux/zenitd
-> zenitd_install_script  => https://raw.githubusercontent.com/Zenit-Linux/zenitd/main/scripts/install.sh

[desktop]
-> environment      => blue-environment
! sddm dziś, w przyszłości HDM
-> display_manager  => sddm

[layout]
! niezmienne korzenie obrazu (patrz docs/PLAN.md)
-> immutable => [/system, /packages, /tools]
-> mutable   => [/state, /home]

[boot]
-> kernel_args => quiet rhgb

[targets]
-> formats => [iso, oci]

[image]
-> oci_name => legendaryos

[tools]
-> catalog => files/usr/share/legendaryos/tools.hk
