# ════════════════════════════════════════════════════════════════════════════
# 0. FIRMWARE — linux-firmware + fwupd
# ════════════════════════════════════════════════════════════════════════════

# Bazowy firmware — WiFi, GPU, BT, NVMe, audio, karta sieciowa itp.
# fedora-bootc ma już część firmware ale linux-firmware daje pełne pokrycie
linux-firmware                   # Główna paczka firmware (Intel, AMD, Realtek, QCA...)
linux-firmware-whence            # Licencje i źródła firmware
amd-gpu-firmware                 # Firmware dla GPU AMD (oddzielna paczka w Fedorze 44)
intel-gpu-firmware               # Firmware dla GPU Intel
nvidia-gpu-firmware              # Firmware dla GPU NVIDIA (wymagane przez nouveau/GSP)

# Firmware dla kart WiFi
atheros-firmware                 # Qualcomm/Atheros WiFi (ath9k, ath10k, ath11k)
brcmfmac-firmware                # Broadcom WiFi (laptopy Apple, niektóre Dell/HP)
mt7xxx-firmware                  # MediaTek WiFi (mt7921, mt7922 — popularne w laptopach)
realtek-firmware                 # Realtek WiFi (rtl8xxx, rtw88, rtw89)
nxpwireless-firmware             # NXP/Marvell WiFi
tiwilink-firmware                # Texas Instruments WiFi/BT

# Firmware dla audio
cirrus-audio-firmware            # Cirrus Logic audio (MacBook, niektóre laptopy)
intel-audio-firmware             # Intel SST/DMIC audio firmware

# Microcode CPU
amd-ucode-firmware               # AMD CPU microcode (bezpieczeństwo + poprawki)
microcode_ctl                    # Intel CPU microcode (automatyczna aktualizacja)

# fwupd — aktualizacja firmware urządzeń przez LVFS (Linux Vendor Firmware Service)
# Obsługuje: ThinkPad, Dell, HP, ASUS, Lenovo, Huawei, Logitech, WD, itp.
fwupd                            # Daemon aktualizacji firmware
fwupd-plugin-flashrom            # Plugin dla chipów flash (BIOS/UEFI)

# Narzędzia diagnostyczne firmware
dmidecode                        # Informacje DMI/SMBIOS (model płyty, BIOS, RAM)


# ════════════════════════════════════════════════════════════════════════════
# 1. COSMIC DE (System76)
# ════════════════════════════════════════════════════════════════════════════

cosmic-session                   # Główna sesja COSMIC DE
cosmic-settings                  # Panel ustawień systemowych
cosmic-settings-daemon           # Daemon ustawień (tło, wygląd, urządzenia)
cosmic-files                     # Menadżer plików COSMIC
cosmic-launcher                  # Launcher aplikacji (Alt+Space)
cosmic-panel                     # Panel systemowy (taskbar + tray)
cosmic-applets                   # Aplety panelu (sieć, dźwięk, zasilanie...)
cosmic-bg                        # Menadżer tapet COSMIC
cosmic-notifications             # Daemon powiadomień
cosmic-osd                       # On-screen display (głośność, jasność)
cosmic-screenshot                # Narzędzie do zrzutów ekranu
cosmic-workspaces                # Zarządzanie przestrzeniami roboczymi
cosmic-edit                      # Edytor tekstu COSMIC
cosmic-store                     # Sklep z aplikacjami COSMIC (Flatpak frontend)
cosmic-greeter                   # Menedżer logowania COSMIC (zastępuje SDDM)
cosmic-idle                      # Daemon wygaszacza ekranu / idle

# Terminal — WezTerm (domyślny, GPU-accelerated, napisany w Rust)
# Repo: repos/wezterm.repo (COPR wezfurlong/wezterm-nightly)
wezterm-common                   # Główny pakiet WezTerm
wezterm-mux-server               # Multiplexer server

xorg-x11-server-Xwayland
wayland
wayland-utils


